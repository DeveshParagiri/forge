#!/bin/sh
# Install or update Forge from a checksummed GitHub Release binary.
set -eu

REPO="${FORGE_REPO:-exaforge/forge}"
VERSION="${FORGE_VERSION:-latest}"
MODE="${FORGE_INSTALL_MODE:-binary}"
INSTALL_BIN="${FORGE_INSTALL_BIN:-${GROK_INSTALL_BIN:-$HOME/.grok/bin/forge}}"
UPDATER="${FORGE_UPDATER:-${GROK_UPDATER:-$HOME/bin/forge-update-from-source}}"
SOURCE_DIR="${FORGE_SRC:-${GROK_SRC:-$HOME/Projects/forge}}"
BRANCH="${FORGE_BRANCH:-${GROK_BRANCH:-main}}"
REPO_URL="${FORGE_REPO_URL:-${GROK_REPO_URL:-https://github.com/$REPO.git}}"

fail() {
  echo "BLOCKED: $*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is not installed. $2"
}

install_links() {
  for link_path in \
    "$HOME/.grok/bin/grok" \
    "$HOME/.local/bin/forge" \
    "$HOME/.local/bin/grok" \
    "$HOME/.local/share/forge/versions/current" \
    "$HOME/.local/share/grok/versions/current" \
    "$HOME/.grok/local/forge" \
    "$HOME/.grok/local/grok" \
    "$HOME/bin/forge" \
    "$HOME/bin/grok"
  do
    mkdir -p "$(dirname "$link_path")"
    if [ "$link_path" != "$INSTALL_BIN" ]; then
      ln -sfn "$INSTALL_BIN" "$link_path"
    fi
  done
}

install_binary() {
  need curl "Install curl and retry."
  need tar "Install tar and retry."

  os=$(uname -s)
  arch=$(uname -m)
  case "$os-$arch" in
    Darwin-arm64) target="aarch64-apple-darwin" ;;
    Linux-aarch64|Linux-arm64) target="aarch64-unknown-linux-gnu" ;;
    *) fail "no Forge release binary is available for $os/$arch (supported: macOS Apple Silicon, Linux ARM64; Windows uses scripts/install.ps1)" ;;
  esac

  asset="forge-$target.tar.gz"
  if [ "$VERSION" = "latest" ]; then
    base="https://github.com/$REPO/releases/latest/download"
  else
    case "$VERSION" in forge-v*) tag="$VERSION" ;; *) tag="forge-v$VERSION" ;; esac
    base="https://github.com/$REPO/releases/download/$tag"
  fi

  tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/forge-install.XXXXXX")
  trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
  echo "==> downloading Forge ${VERSION} for $target"
  curl --fail --location --silent --show-error "$base/$asset" -o "$tmp_dir/$asset"
  curl --fail --location --silent --show-error "$base/$asset.sha256" -o "$tmp_dir/$asset.sha256"

  if command -v shasum >/dev/null 2>&1; then
    (cd "$tmp_dir" && shasum -a 256 -c "$asset.sha256")
  elif command -v sha256sum >/dev/null 2>&1; then
    (cd "$tmp_dir" && sha256sum -c "$asset.sha256")
  else
    fail "shasum or sha256sum is required to verify the release"
  fi

  tar -xzf "$tmp_dir/$asset" -C "$tmp_dir"
  extracted="$tmp_dir/forge"
  if [ ! -x "$extracted" ]; then
    # Releases published before the canonical executable rename contained
    # `grok` inside the same checksummed forge-* archive.
    extracted="$tmp_dir/grok"
  fi
  [ -x "$extracted" ] || fail "release archive did not contain an executable named forge or grok"

  mkdir -p "$(dirname "$INSTALL_BIN")"
  install -m 755 "$extracted" "$INSTALL_BIN.new.$$"
  mv -f "$INSTALL_BIN.new.$$" "$INSTALL_BIN"

  if [ "$os" = "Darwin" ] && command -v codesign >/dev/null 2>&1; then
    codesign --force --sign - "$INSTALL_BIN"
    codesign --verify "$INSTALL_BIN"
  fi

  # Keep the old executable name working for existing installations.
  legacy_bin="$(dirname "$INSTALL_BIN")/grok"
  if [ "$legacy_bin" != "$INSTALL_BIN" ]; then
    # A previous install may already have made `grok` a symlink to the
    # canonical `forge` binary. Remove only that compatibility link before
    # refreshing it so `cp` never tries to copy a file onto itself.
    if [ -L "$legacy_bin" ]; then
      rm -f "$legacy_bin"
    fi
    cp "$INSTALL_BIN" "$legacy_bin"
    chmod 755 "$legacy_bin"
    if [ "$os" = "Darwin" ] && command -v codesign >/dev/null 2>&1; then
      codesign --force --sign - "$legacy_bin"
    fi
  fi

  # Keep `forge update` and the documented recovery command on one canonical
  # installer implementation. The updater simply re-runs this release installer.
  mkdir -p "$(dirname "$UPDATER")"
  updater_cache_bust=$(date +%s)
  curl --fail --location --silent --show-error \
    "https://raw.githubusercontent.com/$REPO/main/scripts/install?forge_update=$updater_cache_bust" \
    -o "$UPDATER.new.$$"
  chmod 755 "$UPDATER.new.$$"
  mv -f "$UPDATER.new.$$" "$UPDATER"

  install_links
  trap - EXIT HUP INT TERM
  rm -rf "$tmp_dir"
  echo "Installed: $($INSTALL_BIN --version 2>/dev/null || echo Forge)"
  echo "  binary: $INSTALL_BIN"
  echo "  update: forge update (grok update also remains supported)"
}

install_source() {
  need git "Install Git and retry."
  need cargo "Run https://rustup.rs and retry."
  if ! command -v dotslash >/dev/null 2>&1 && ! command -v protoc >/dev/null 2>&1; then
    fail "dotslash or protoc is not installed. Install either one and retry."
  fi
  [ ! -e "$SOURCE_DIR" ] || [ -d "$SOURCE_DIR/.git" ] || \
    fail "$SOURCE_DIR exists but is not a Git checkout"
  if [ ! -d "$SOURCE_DIR/.git" ]; then
    mkdir -p "$(dirname "$SOURCE_DIR")"
    git clone --branch "$BRANCH" "$REPO_URL" "$SOURCE_DIR"
  fi
  (cd "$SOURCE_DIR" && cargo build --locked -p xai-grok-pager-bin --release)
  mkdir -p "$(dirname "$INSTALL_BIN")"
  install -m 755 "$SOURCE_DIR/target/release/forge" "$INSTALL_BIN"
  if [ "$(uname -s)" = "Darwin" ] && command -v codesign >/dev/null 2>&1; then
    codesign --force --sign - "$INSTALL_BIN"
    codesign --verify "$INSTALL_BIN"
  fi
  install_links
  echo "Installed source build from $SOURCE_DIR"
}

case "$MODE" in
  binary) install_binary ;;
  source) install_source ;;
  *) fail "FORGE_INSTALL_MODE must be 'binary' or 'source'" ;;
esac
